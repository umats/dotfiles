      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low"
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "medium"
      },
      "worker": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium"
      },
      "oracle": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high"
      }
    }
  }
}
