{
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-lens",
    "npm:pi-prompt-template-model",
    "npm:@sting8k/pi-vcc",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-green",
    "npm:pi-model-alias",
    "npm:tsubus-agent-skills",
    "npm:@upstash/context7-pi",
    "npm:@narumitw/pi-chrome-devtools",
    "npm:pi-memory",
    "npm:pi-subagents",
    "npm:pi-fff",
    "npm:@utpalsinghdev/pi-context-window",
    "git:github.com/obra/superpowers"
  ],
  "extensions": [
    "~/iac/dotfiles/pi/extensions/context-vcc.ts"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6.1-sol"
  ],
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "low"
      },
      "scout": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium"
      },
      "researcher": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "medium"
      },
      "worker": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "medium"
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "high"
      }
    }
  }
}