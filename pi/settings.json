{
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-lens",
    "npm:pi-prompt-template-model",
    "npm:@sting8k/pi-vcc",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-green",
    "npm:tsubus-agent-skills",
    "npm:@upstash/context7-pi",
    "npm:@narumitw/pi-chrome-devtools",
    "npm:pi-memory",
    "npm:pi-subagents",
    "npm:pi-fff",
    "npm:@utpalsinghdev/pi-context-window",
    "git:github.com/obra/superpowers",
    "npm:pi-claude-bridge"
  ],
  "extensions": [
    "~/iac/dotfiles/pi/extensions/context-vcc.ts"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-sonnet-5-5",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "claude-bridge/claude-opus-5-5",
    "claude-bridge/claude-sonnet-5-5",
    "claude-bridge/claude-haiku-5-5"
  ],
  "subagents": {
    "defaultSubagentOnlyExtensions": ["~/.pi/agent/npm/node_modules/pi-claude-bridge/src/index.ts"],
    "agentOverrides": {
      "delegate": {
        "model": "claude-bridge/claude-haiku-5-5",
        "thinking": "low"
      },
      "scout": {
        "model": "claude-bridge/claude-haiku-5-5",
        "thinking": "medium"
      },
      "researcher": {
        "model": "claude-bridge/claude-sonnet-5-5",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "claude-bridge/claude-opus-5-5",
        "thinking": "medium"
      },
      "worker": {
        "model": "claude-bridge/claude-sonnet-5-5",
        "thinking": "medium"
      },
      "oracle": {
        "model": "claude-bridge/claude-opus-5-5",
        "thinking": "high"
      }
    }
  }
}
