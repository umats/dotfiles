    "read"
  ],
  "model_profiles": {
    "frontend": {
      "model": "openai-codex/gpt-5.6-terra",
      "effort": "medium"
    },
    "git-manager": {
      "model": "openai-codex/gpt-5.6-luna",
      "effort": "medium"
    },
    "browser-validator": {
      "model": "openai-codex/gpt-5.6-terra",
      "effort": "medium"
    },
    "security-reviewer": {
      "model": "openai-codex/gpt-5.6-terra",
      "effort": "medium"
    },
    "ops-release-operator": {
      "model": "openai-codex/gpt-5.6-terra",
      "effort": "medium"
    },
    "spark-worker": {
      "model": "openai-codex/gpt-5.3-codex-spark",
      "effort": "low"
    },
    "implementer": {
      "model": "openai-codex/gpt-5.6-terra",
      "effort": "medium"
    },
    "planner": {
      "model": "openai-codex/gpt-5.6-sol",
      "effort": "medium"
    },
    "researcher": {
      "model": "openai-codex/gpt-5.6-luna",
      "effort": "low"
    },
    "reviewer": {
      "model": "openai-codex/gpt-5.6-sol",
      "effort": "medium"
    },
    "verifier": {
      "model": "openai-codex/gpt-5.6-luna",
      "effort": "medium"
    }
  }
